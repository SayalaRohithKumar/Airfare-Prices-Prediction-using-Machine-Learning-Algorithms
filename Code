# ALL FUNCTIONS UNCHANGED - WORKING PERFECTLY
def upload_dataset():
    global dataset
    log("UPLOADING DATASET")
    filename = filedialog.askopenfilename(initialdir="./", title="Select CSV", filetypes=[("CSV files", "*.csv")])
    if filename:
        try:
            dataset = pd.read_csv(filename, nrows=1000)
            log("Dataset loaded successfully")
            log("Shape: " + str(dataset.shape))
            log("Columns: " + str(list(dataset.columns)))
            log(str(dataset.head(2)))
            status_label.config(text="DATA LOADED", fg="lime")
        except Exception as e:
            messagebox.showerror("Error", str(e))

def preprocess_data():
    global dataset, X, Y, X_train, X_test, y_train, y_test, sc_x, sc_y, label_encoders
    if dataset is None:
        messagebox.showerror("Error", "Upload dataset first")
        return
    log("PREPROCESSING DATA")
    dataset.fillna('Unknown', inplace=True)
    if 'Date_of_Journey' in dataset.columns:
        dataset.drop('Date_of_Journey', axis=1, inplace=True)
    feature_cols = ['Airline', 'Source', 'Destination', 'Route', 'Additional_Info', 'Dep_Time', 'Arrival_Time', 'Duration', 'Total_Stops']
    available_cols = [col for col in feature_cols if col in dataset.columns]
    if len(available_cols) < 5:
        messagebox.showerror("Error", "Need more feature columns")
        return
    log("Using columns: " + str(available_cols))
    label_encoders.clear()
    for col in available_cols:
        le = LabelEncoder()
        dataset[col] = le.fit_transform(dataset[col].astype(str))
        label_encoders[col] = le
    X_full = dataset[available_cols].values
    Y_full = dataset['Price'].values.reshape(-1, 1)
    X_scaled = sc_x.fit_transform(X_full)
    Y_scaled = sc_y.fit_transform(Y_full)
    X_train, X_test, y_train, y_test = train_test_split(X_scaled, Y_scaled, test_size=0.2, random_state=42)
    X, Y = X_scaled, Y_scaled
    log("Preprocessing COMPLETE")
    status_label.config(text="READY TO TRAIN", fg="cyan")

def train_model(model_func, model_name):
    global final_model, current_model_name, accuracy_list, X, Y, X_test, y_test
    if X is None:
        messagebox.showerror("Error", "Preprocess data first")
        return
    log("TRAINING " + model_name)
    start_time = timeit.default_timer()
    try:
        model = model_func()
        model.fit(X, Y.ravel())
        y_pred = model.predict(X_test).reshape(-1, 1)
        y_pred_orig = sc_y.inverse_transform(y_pred)
        y_test_orig = sc_y.inverse_transform(y_test)
        r2 = model.score(X, Y.ravel())
        accuracy_list.append((model_name, r2))
        time_taken = timeit.default_timer() - start_time
        log(model_name + " R2 Score: " + str(round(r2*100, 2)) + "%")
        log("Training time: " + str(round(time_taken, 3)) + " seconds")
        final_model = model
        current_model_name = model_name
        
        # Color code trained model buttons
        key = model_name.split()[0]
        if key in model_btns:
            color = "#00ff88" if r2>0.8 else "#ffaa00" if r2>0.6 else "#ff4444"
            model_btns[key].config(bg=color)
        
        status_label.config(text=model_name + " READY | R2: " + str(round(r2*100,1)) + "%", fg="lime")
        
        plt.figure(figsize=(12,5))
        plt.subplot(1,2,1)
        plt.plot(y_test_orig[:50].flatten(), 'ro-', label='Actual')
        plt.plot(y_pred_orig[:50].flatten(), 'go-', label='Predicted')
        plt.legend(); plt.title(model_name); plt.grid(True)
        plt.subplot(1,2,2)
        plt.scatter(y_test_orig, y_pred_orig, alpha=0.6)
        plt.plot([y_test_orig.min(), y_test_orig.max()], [y_test_orig.min(), y_test_orig.max()], 'r--')
        plt.xlabel('Actual'); plt.ylabel('Predicted'); plt.title('R2 Correlation'); plt.grid(True)
        plt.tight_layout(); plt.show()
        log(model_name + " ready for predictions")
    except Exception as e:
        log("ERROR: " + str(e))

def random_forest(): train_model(lambda: RandomForestRegressor(n_estimators=100, random_state=42), "Random Forest")
def mlp_regressor(): train_model(lambda: MLPRegressor(hidden_layer_sizes=(100,), max_iter=500, random_state=42), "MLP Neural")
def decision_tree(): train_model(lambda: DecisionTreeRegressor(random_state=42), "Decision Tree")
def linear_regression(): train_model(lambda: LinearRegression(), "Linear Reg")
def bagging_regressor(): train_model(lambda: BaggingRegressor(n_estimators=50, random_state=42), "Bagging Reg")
def poly_svm(): train_model(lambda: SVR(kernel='poly', C=1.0, gamma='scale'), "Poly SVM")
def linear_svm(): train_model(lambda: SVR(kernel='linear', C=1.0), "Linear SVM")

def predict_price():
    global final_model, label_encoders, sc_x, sc_y, current_model_name
    if final_model is None:
        messagebox.showerror("Error", "Train a model first")
        return
    pred_win = Toplevel(root)
    pred_win.title("Predict Flight Price")
    pred_win.geometry("550x750")
    pred_win.configure(bg='#1a1f2e')
    Label(pred_win, text="Active Model: " + current_model_name, font=('Arial', 16, 'bold'), bg='#1a1f2e', fg='cyan').pack(pady=15)
    feature_cols = list(label_encoders.keys())
    entries = {}
    for col in feature_cols:
        frame = Frame(pred_win, bg='#1a1f2e')
        frame.pack(pady=8, padx=25, fill='x')
        Label(frame, text=col + ":", font=('Arial', 12, 'bold'), bg='#1a1f2e', fg='white', width=15).pack(side='left')
        entry = Entry(frame, font=('Arial', 11), width=25, bg='#2a2f3b', fg='white', insertbackground='white')
        entry.pack(side='right', padx=10)
        entries[col] = entry
        if col == 'Airline':
            entry.insert(0, label_encoders[col].classes_[0])
        elif col == 'Source':
            entry.insert(0, label_encoders[col].classes_[0])
    def do_predict():
        try:
            input_data = []
            for col in feature_cols:
                val = entries[col].get().strip()
                encoded = label_encoders[col].transform([val])[0]
                input_data.append(encoded)
            X_new = np.array([input_data]).reshape(1, -1)
            X_new_scaled = sc_x.transform(X_new)
            y_pred_scaled = final_model.predict(X_new_scaled).reshape(1, -1)
            price = sc_y.inverse_transform(y_pred_scaled)[0, 0]
            result = "PREDICTED PRICE: Rs." + str(round(price, 2)) + "\n\n"
            result += "Flight Details:\n"
            for col in feature_cols:
                result += col + ": " + entries[col].get() + "\n"
            result += "\nModel: " + current_model_name
            messagebox.showinfo("Prediction Result", result)
            log("NEW PREDICTION: Rs." + str(round(price, 2)))
            pred_win.destroy()
        except Exception as e:
            messagebox.showerror("Error", "Invalid input: " + str(e))
    Button(pred_win, text="PREDICT PRICE", command=do_predict, font=('Arial', 16, 'bold'), bg='#ff4757', fg='white', width=22, height=2, relief='raised', bd=3).pack(pady=25)

def show_accuracy_graph():
    if not accuracy_list:
        messagebox.showwarning("Warning", "Train models first")
        return
    names = [name for name, acc in accuracy_list]
    scores = [acc*100 for name, acc in accuracy_list]
    plt.figure(figsize=(14, 8))
    plt.bar(names, scores, color='skyblue', edgecolor='navy')
    plt.title('Model Accuracy Comparison')
    plt.ylabel('R2 Score (%)')
    plt.xlabel('Algorithms')
    plt.xticks(rotation=45, ha='right')
    plt.ylim(0, 105)
    plt.grid(True, alpha=0.3)
    for i, score in enumerate(scores):
        plt.text(i, score + 1, str(round(score, 1)) + '%', ha='center', fontweight='bold')
    plt.tight_layout()
    plt.show()

